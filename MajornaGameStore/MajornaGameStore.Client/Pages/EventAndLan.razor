@page "/eventandlan"
@using MajornaGameStore.DataAccess.Entities
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject NavigationManager NavManager
@inject EventsViewModel ViewModel


<PageTitle>Events and LAN</PageTitle>


@if (_pageLoading)
{
    <p>Loading...</p>
    <Spinner />
}
else
{
    <Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />
    <div class="row">
        <h3>Kommande LAN & Events</h3>
        <ul class="list-group">
            <Virtualize Items="ViewModel.Models">

                <li class="list-group-item">
                    <p class="h5">
                        @context.Name
                    </p>
                    <p>
                        @context.Description (@context.Price KR)
                    </p>
                    <button id="Goto" class="btn-detailpage" style="margin-left: 20px" @onclick="@(async () => await GoToDetailsAsync(context.Id))">Mer om eventet</button>
                    <button id="addcart" class="btn-add btn-success" @onclick="@(async () => await ViewModel.AddToCartAsync(context, 1))">Köp</button>
                </li>
            </Virtualize>
        </ul>
    </div>



}



@code
{
    bool _pageLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ViewModel.OnInit();
            _pageLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }


    private async Task GoToDetailsAsync(int Id)
    {
        NavManager.NavigateTo($"/eventDetail/{Id}");
    }
    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(ToastType toastType) => messages.Add(CreateToastMessage(toastType));

    private ToastMessage CreateToastMessage(ToastType toastType)
        => new ToastMessage
            {
                Type = toastType,
                HelpText = $"{DateTime.Now}",
                Message = $"Produkt tillagd i kundvagn!",
            };
}

