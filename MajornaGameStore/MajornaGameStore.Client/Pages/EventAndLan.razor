@page "/eventandlan"
@inject NavigationManager NavManager
@inject EventsViewModel ViewModel


<PageTitle>Events and LAN</PageTitle>

@if (_pageLoading)
{
    <p>Loading...</p>
    <Spinner/>
}
else
{
    <div class="row">
        <ul class="list-group">
        <Virtualize Items="ViewModel.Models">

            <li class="list-group-item">
                <p>
                    @context.Name
                </p>
                <p>
                    @context.Description (@context.Price KR)
                </p>
                <button class="btn-detailpage" style="margin-left: 20px" @onclick="@(async () => GoToDetailsAsync(context))" >Mer om eventet</button>
                <button class="btn-add" @onclick="@(async () => await ViewModel.AddToCartAsync(context))">Köp</button>
            </li>
        </Virtualize>
        </ul>
    </div>
}



@code
{
    bool _pageLoading = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ViewModel.OnInit();
            _pageLoading = false;
            StateHasChanged();
        }

        @*await base.OnAfterRenderAsync(firstRender);*@
    }

    private void GoToDetailsAsync(EventDto events)
    {
        NavManager.NavigateTo("/EventDetail");
    }
}

