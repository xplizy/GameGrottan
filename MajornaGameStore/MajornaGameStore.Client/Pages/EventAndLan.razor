@page "/eventandlan"
@inject NavigationManager NavManager
@inject EventsViewModel ViewModel
<style>
    body {
        background-image: url(https://majornastorage.blob.core.windows.net/images/GamrGrottanLAN.png);
    }
</style>

<PageTitle>Events and LAN</PageTitle>

@if (_pageLoading)
{
    <p>Loading...</p>
    <Spinner/>
}
else
{
    <Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <ul class="list-group">
                    <Virtualize Items="ViewModel.Models">
                        <li class="list-group-item mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <h5>@context.Name</h5>
                                    <p>@context.Description (@context.Price KR)</p>
                                    <p>
                                        Start Tid: @context.Start | Slut Tid: @context.End
                                    </p>
                                </div>
                                <div class="col-md-6 text-right">
                                    <button id="Goto" class="btn btn-outline-primary" @onclick="@(async () => await GoToDetailsAsync(context.Id))">Mer om eventet</button>
                                    <button class="btn btn-success ml-2" @onclick="@(async () => { await ViewModel.AddToCartAsync(context, 1); ShowMessage(ToastType.Success); })">Lägg Till I Kundvagn</button>
                                </div>
                            </div>
                        </li>
                    </Virtualize>
                </ul>
            </div>
        </div>
    </div>

}
 


@code
{
    bool _pageLoading = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ViewModel.OnInit();
            _pageLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GoToDetailsAsync(int Id)
    {
        NavManager.NavigateTo($"/eventDetail/{Id}");
    }
    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(ToastType toastType) => messages.Add(CreateToastMessage(toastType));

    private ToastMessage CreateToastMessage(ToastType toastType)
        => new ToastMessage
            {
                Type = toastType,
                HelpText = $"{DateTime.Now}",
                Message = $"Produkt tillagd i kundvagn!",
            };
}

