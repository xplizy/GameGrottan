@page "/eventandlan"
@using MajornaGameStore.DataAccess.Entities
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject NavigationManager NavManager
@inject EventsViewModel ViewModel


<PageTitle>Events and LAN</PageTitle>


@if (_pageLoading)
{
    <p>Loading...</p>
    <Spinner/>
}
else
{
    <div class="row">
        <h3>Kommande LAN & Events</h3>
        <ul class="list-group">
            <Virtualize Items="ViewModel.Models">

                <li class="list-group-item">
                    <p class="h5">
                        @context.Name
                    </p>
                    <p>
                        @context.Description (@context.Price KR)
                    </p>
                    <button id="Goto" class="btn-detailpage" style="margin-left: 20px" @onclick="@(async () => await GoToDetailsAsync(context.Id))">Mer om eventet</button>
                    <button id="addcart" class="btn-add btn-success" @onclick="@(async () => await AddToCartAsync(context))">Köp</button>
                </li>
                <Modal @ref="successModal" Title="@context.Name" Size="ModalSize.Small">
                    <BodyTemplate>
                        <p style="color: black;">har lagts till i varukorgen</p>
                    </BodyTemplate>

                </Modal>
            </Virtualize>
        </ul>
    </div>

    

}
 


@code
{
    bool _pageLoading = true;
    Modal successModal;
    Timer timer;
    bool modalVisible = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ViewModel.OnInit();
            _pageLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    

    private async Task AddToCartAsync(EventDto eventDto)
    {
        await ViewModel.AddToCartAsync(eventDto, 1);

        successModal.ShowAsync();
        modalVisible = true;

        timer = new Timer(async (_) =>
        {
            await successModal.HideAsync();
            modalVisible = false;
            StateHasChanged();
        }, null, 1500, Timeout.Infinite);
    }


    private async Task GoToDetailsAsync(int Id)
    {
        NavManager.NavigateTo($"/eventDetail/{Id}");
    }

    
}

