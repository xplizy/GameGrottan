@page "/eventDetail/{Id}"
@using MajornaGameStore.Client.Services
@inject EventDetailViewModel ViewModel


@if (_pageLoading)
{
    <Spinner/>
}
else
{
    <div class="event-page">
        <img src="Images/MAJORNA-LAN.png" style="float: left; margin-right: 20px"/>
        <div style="float: left">
            <h4> @ViewModel.SelectedEvent.Name</h4>
            <p> Beskrivning: @ViewModel.SelectedEvent.Description</p>
            <p> Entre pris: @ViewModel.SelectedEvent.Price kr per person</p>
            <p> Start Datum: @ViewModel.SelectedEvent.Start</p>
            <p> Slut Datum: @ViewModel.SelectedEvent.End</p>
            <button class="btn-add btn-success" @onclick="@(async () => await ViewModel.AddToCartAsync(@ViewModel.SelectedEvent, 1))">Köp</button>
        </div>
        <div style="clear: both"></div>
    </div>
    
}


@code {
    bool _pageLoading = true;

    [Parameter]
    public string Id { get; set; }

    private int eventId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (int.TryParse(Id, out eventId))
            {
                await ViewModel.OnInite(eventId);
                _pageLoading = false;
                StateHasChanged();
                await base.OnAfterRenderAsync(firstRender);
            }
           
            
        }
        
    }

  
}