@page "/login"
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Logga in</PageTitle>

<div class="card p-3 mb-3">
    <div class="mb-3">
        <h1>Logga in</h1>
    </div>

    <EditForm Model="LoginModel" OnSubmit="Authenticate">
        <div class="mb-3">
            <InputText @bind-Value="LoginModel.Email" Placeholder="Användarnamn" class="form-control mb-3"/>
        </div>
        <div class="mb-3">
            <input class="form-control" type="password" placeholder="Lösenord" @bind="LoginModel.Password"/>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Logga in</button>
        </div>
    </EditForm>

</div>

@code
{
    LoginDto LoginModel = new();
    protected override async Task OnInitializedAsync()
    {

    }

    async Task Authenticate()
    {
        var customAuthProvider = (CookieAuthenticationStateProvider)AuthStateProvider;
        var success = await customAuthProvider.LoginAndGetAuthenticationState(LoginModel);

        if (success)
        {
            //If admin redirect to admin page, if user redirect to userpage
        }
        else
        {
            //let user know login failed
        }
    }
}