@page "/products"
@using MajornaGameStore.Shared.Dtos
@using System.Formats.Tar
@using MajornaGameStore.Client.Services
@inject ICartService CartService
<PageTitle>Products</PageTitle>

<div class="row" style="display: flex; flex-wrap: wrap;">
    @foreach (var item in cartItems)
    {
        <div class="col-md-3" style="flex: 0 0 25%;">
            <div class="item-container">
                <div class="item-image-wrapper"><img src="Images/GameCovers/@item.Image" class="item-image" style="width: 200px; height: 200px;"/></div>
                <div class="item-name">
                    <h5><a>@item.Name</a></h5>
                    <button class="btn-add" @onclick="@(() => AddToCart(item) )">
                        Lägg Till I Kundvagn
                    </button>
                </div>
            </div>
            
            <div class="item-price">Sek @(item.Price)</div>
        </div>
    }

</div>

@code
{
    List<CartItemDto> cartItems = new List<CartItemDto>();

    protected override async Task OnInitializedAsync()
    {
        cartItems.Add(new CartItemDto() { Name = "Elden Ring", Price = 600, Image = "Elden.jpg" });
        cartItems.Add(new CartItemDto() { Name = "Sekiro: Shadows Die Twice", Price = 600, Image = "Sekiro.jpg" });
        cartItems.Add(new CartItemDto() { Name = "Niklas Adventure: Tjohoo", Price = 700, Image = "NiklasA.jpg" });

        cartItems.Add(new CartItemDto() { Name = "Rlden Eing", Price = 500, Image = "Elden.jpg" });
        cartItems.Add(new CartItemDto() { Name = "Sekiro: Shadows Live Twice", Price = 699, Image = "Sekiro.jpg" });
        cartItems.Add(new CartItemDto() { Name = "Niklas Combat Evolved: Tjohoo", Price = 700, Image = "NiklasA.jpg" });
    }

    private async Task AddToCart(CartItemDto item)
    {
        await CartService.AddItemToCartAsync(item);
    }

}
