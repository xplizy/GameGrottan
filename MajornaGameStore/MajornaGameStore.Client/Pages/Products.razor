@page "/products"
@using MajornaGameStore.Shared.Dtos
@using System.Formats.Tar
@using MajornaGameStore.Client.Services
@using MajornaGameStore.Shared.Interfaces
@using MajornaGameStore.Shared.Models.ViewModels
@inject ICartService CartService
@inject ProductViewModel ViewModel
<PageTitle>Products</PageTitle>

@if (_contentLoading)
{
    <p>Loading...</p>
   
}
else
{

    <Virtualize Items="ViewModel.Models">
        <div class="col-md-3" style="flex: 0 0 25%;">
            <div class="item-container">
                <div class="item-image-wrapper"><img src="@context.ImageLink" class="item-image" style="width: 200px; height: 200px;"/></div>
                <div class="item-name">
                    <h5><a>@context.Name</a></h5>
                    @*<button class="btn-add" @onclick="@(() => AddToCart(item))">
                Lägg Till I Kundvagn
                </button> *@
                </div>
            </div>
                
            @* <div class="item-price">Sek @(item.Price)</div> *@
        </div>
    </Virtualize>
}



@code
{
    bool _contentLoading = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ViewModel.OnInit();
        _contentLoading = false;
        StateHasChanged();
    }

    // private async Task AddToCart(CartItemDto item)
    // {
    //     await CartService.AddItemToCartAsync(item);
    // }

}
