@page "/products"
@using MajornaGameStore.Shared.Dtos
@using System.Formats.Tar
@using MajornaGameStore.Client.Services
@using MajornaGameStore.Shared.Interfaces
@using MajornaGameStore.Shared.Models.ViewModels
@inject ProductViewModel ViewModel
@inject NavigationManager NavManager

<PageTitle>Products</PageTitle>

@if (_contentLoading)
{
    <p>Loading...</p>
    <Spinner/>
   
}
else
{
    <div class="row" style="display: flex; flex-wrap: wrap;">
        <Virtualize Items="ViewModel.Models">
            <div class="col-md-3" style="flex: 0 0 25%;">
                <div class="item-container" style="margin-bottom: 30px">
                    <div class="item-image-wrapper">
                        <img src="@context.ImageLink" class="item-image" style="width: 100%; height: auto;" @onclick="@(async () => GoToDetailsAsync(context))" />
                    </div>
                    
                    <div class="item-name">
                        <h5><a>@context.Name</a></h5>
                        <div class="item-details d-flex alignt-items-center justify-content-between">
                        <div class="item-price" style="margin-left: 5px" >Sek @(context.Price)</div>
                        <button id="addToCartBtn" class="btn-add" style="margin-right: 5px" @onclick="@(async () => await ViewModel.AddToCartAsync(context, 1))">
                            Lägg I Kundvagn
                        </button>
                        </div>
                    </div>
                
                </div>
                
            </div>
        </Virtualize>
    </div>

}



@code
{
    bool _contentLoading = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ViewModel.OnInit();
            _contentLoading = false;
            StateHasChanged();
        }
    }

    private void GoToDetailsAsync(ProductDto product)
    {
        NavManager.NavigateTo("/productDetail");
    }

}
